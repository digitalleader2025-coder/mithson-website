# Book a Meeting — copy to .env for local testing, and add the same keys in
# Vercel → Project → Settings → Environment Variables for the live site.
# On Vercel all three groups are required; locally, missing ones are skipped (dry run).

# Booking storage (Upstash Redis — Vercel Marketplace "Upstash for Redis" sets these automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Zoom Server-to-Server OAuth app (marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth)
# Required scope: meeting:write:meeting:admin (or meeting:write:admin)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Zoom user who hosts the meetings (email or user id); defaults to the app owner
ZOOM_USER_ID=

# SMTP for confirmation emails (e.g. the company mail server, or Gmail with an app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mithson Sealing Solutions <sales@mithson.com>"

# Company inbox that receives every new booking
BOOKING_NOTIFY_EMAIL=sales@mithson.com
