# Book a Meeting — copy to .env for local testing, and add the same keys in
# Vercel → Project → Settings → Environment Variables for the live site.
# On Vercel the storage and SMTP groups are required, plus Microsoft and/or Google for the
# platform customers choose. Locally, missing ones are skipped (dry run).

# Booking storage (Upstash Redis — Vercel Marketplace "Upstash for Redis" sets these automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Microsoft Teams (needs a Microsoft 365 work account with Teams and an Outlook mailbox)
# entra.microsoft.com → App registrations → New registration, then add the Microsoft Graph
# APPLICATION permission Calendars.ReadWrite and grant admin consent.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Mithson work account that hosts the Teams meetings
MS_ORGANIZER_EMAIL=

# Google Meet (console.cloud.google.com → enable Google Calendar API, create an OAuth client,
# then sign in once as the hosting Google account to get a refresh token with the
# calendar.events scope). Set the OAuth app to "In production" or the token expires in 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: calendar that holds the meetings; defaults to the account's main calendar
GOOGLE_CALENDAR_ID=primary

# Supabase for enquiry files and records (supabase.com → your project → Project Settings)
# Run supabase/enquiries.sql and supabase/applications.sql once in the SQL Editor first. Keep the secret key out of the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# SMTP for confirmation emails (e.g. the company mail server, or Gmail with an app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mithson Sealing Solutions <sales@mithson.com>"

# Inbox that receives job applications; defaults to BOOKING_NOTIFY_EMAIL
HR_NOTIFY_EMAIL=

# Company inbox that receives every new booking
BOOKING_NOTIFY_EMAIL=sales@mithson.com
